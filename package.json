{
  "dependencies": {
    "@koa/router": "^12.0.1",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "playwright": "^1.49.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "description": "Local multi-profile fingerprint browser with a local automation API. Clean-room implementation for learning/research. No vendor backend required.",
  "author": "chainfix",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "name": "cike",
  "scripts": {
    "smoke": "node test/smoke.js",
    "start": "node src/server.js",
    "electron": "electron .",
    "pack:mac-arm64": "electron-packager . CIKE --icon=electron/assets/icon.icns --platform=darwin --arch=arm64 --out=dist --overwrite --prune --ignore=\"^/(test|.browsers|dist|.*.zip$)\"",
    "pack:win-x64": "electron-packager . CIKE --icon=electron/assets/icon.ico --platform=win32 --arch=x64 --out=dist --overwrite --prune --win32metadata.CompanyName=CIKE --win32metadata.ProductName=CIKE --win32metadata.FileDescription=CIKE --win32metadata.InternalName=CIKE --ignore=\"^/(test|.browsers|dist|.*\\.zip$)\"",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:dir": "electron-builder --win dir --x64"
  },
  "type": "commonjs",
  "version": "0.5.16",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
